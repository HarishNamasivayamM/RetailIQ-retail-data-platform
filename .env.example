SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=RETAILIQ_ENGINEER
SNOWFLAKE_WAREHOUSE=RETAILIQ_XS
SNOWFLAKE_DATABASE=RETAILIQ
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_STAGE=RETAILIQ.RAW.RETAILIQ_STAGE
SNOWFLAKE_STAGE_PATH=RETAILIQ.RAW.RETAILIQ_STAGE/batch_001
